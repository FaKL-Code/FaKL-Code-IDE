---
// Cena portada do filme de apresentação (v-mesa.html).
import { langDaUrl, pastaFilme, textos } from '../../../i18n';
const C = textos(langDaUrl(Astro.url)).cena;
const F = pastaFilme(langDaUrl(Astro.url));
---

<div class="cena" id="cena-vm-mesa" data-cena="vm-mesa">
    <div id="vm-glow"></div>
    <div id="vm-floor"></div>
    <div id="vm-stage">
      <div id="vm-world">
        <img id="vm-base" src={`${F}/mesa-base.webp`} alt="" />
        <img id="vm-ropes" src={`${F}/mesa-ropes.webp`} alt="" />
        <img id="vm-a1" class="vm-card" src={`${F}/mesa-card-a1.webp`} alt="" style="left: 876px; top: 166px" />
        <img id="vm-a2" class="vm-card" src={`${F}/mesa-card-a2.webp`} alt="" style="left: 456px; top: 566px" />
        <img id="vm-a3" class="vm-card" src={`${F}/mesa-card-a3.webp`} alt="" style="left: 876px; top: 566px" />
        <img id="vm-a4" class="vm-card" src={`${F}/mesa-card-a4.webp`} alt="" style="left: 1296px; top: 566px" />
        <div id="vm-r1" class="vm-ring" style="left: 896px; top: 186px"></div>
        <div id="vm-r2" class="vm-ring" style="left: 476px; top: 586px"></div>
        <div id="vm-r3" class="vm-ring" style="left: 896px; top: 586px"></div>
        <div id="vm-r4" class="vm-ring" style="left: 1316px; top: 586px"></div>
      </div>
    </div>
    <div id="vm-rail">
      <span class="tag">MAESTRO</span>
      <span class="chip" id="vm-c1">{C.mesa.planejando}</span>
      <span class="chip" id="vm-c2">{C.mesa.execucao}</span>
      <span class="chip" id="vm-c3">{C.mesa.revisao}</span>
      <span class="chip" id="vm-c4">{C.mesa.pr}</span>
    </div>
    <div id="vm-cost">
      <div class="lbl">{C.mesa.gasto}</div>
      <div id="vm-num"><span class="cur">{C.mesa.moeda}</span><span id="vm-val">0.00</span></div>
      <div id="vm-bar"><div id="vm-fill"></div></div>
      <div id="vm-cap-row"><span>{C.mesa.teto}</span><b>{C.mesa.limite}</b></div>
    </div>
    <div class="vm-slam"><b id="vm-s1">CLAUDE.</b></div>
    <div class="vm-slam"><b id="vm-s2">CODEX.</b></div>
    <div class="vm-slam"><b id="vm-s3">GEMINI.</b></div>
    <div id="vm-flash"></div>
  
</div>

<style is:global>
#cena-vm-mesa {
  position: absolute;
  inset: 0;
  background: var(--bg);
  overflow: hidden;
}
#cena-vm-mesa #vm-glow {
  position: absolute;
  left: -260px;
  top: 260px;
  width: 1600px;
  height: 1400px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(37, 99, 235, 0.32) 0%, rgba(37, 99, 235, 0) 65%);
}
#cena-vm-mesa #vm-floor {
  position: absolute;
  left: -900px;
  top: 1100px;
  width: 2880px;
  height: 1400px;
  background-image: linear-gradient(rgba(6, 224, 255, 0.16) 2px, transparent 2px),
  linear-gradient(90deg, rgba(6, 224, 255, 0.16) 2px, transparent 2px);
  background-size: 80px 80px;
  transform: perspective(900px) rotateX(62deg);
  transform-origin: 50% 0;
  opacity: 0;
}
#cena-vm-mesa #vm-stage {
  position: absolute;
  inset: 0;
  perspective: 2200px;
  perspective-origin: 50% 50%;
}
#cena-vm-mesa /* O mundo é a Mesa em 1x (1920x1080),
#cena-vm-mesa com o centro no centro do quadro vertical. */
        #vm-world {
  position: absolute;
  left: -420px;
  top: 420px;
  width: 1920px;
  height: 1080px;
  transform-style: preserve-3d;
  transform-origin: 50% 50%;
}
#cena-vm-mesa #vm-world img {
  position: absolute;
  display: block;
}
#cena-vm-mesa #vm-base,
#cena-vm-mesa #vm-ropes {
  left: 0;
  top: 0;
  width: 1920px;
  height: 1080px;
}
#cena-vm-mesa #vm-base {
  box-shadow: 0 0 0 2px #374151, 0 60px 140px rgba(0, 0, 0, 0.7);
  border-radius: 6px;
}
#cena-vm-mesa .vm-card {
  width: 408px;
  height: 348px;
}
#cena-vm-mesa .vm-ring {
  position: absolute;
  width: 368px;
  height: 308px;
  border: 4px solid var(--accent);
  border-radius: 14px;
  box-shadow: 0 0 40px rgba(6, 224, 255, 0.7);
  opacity: 0;
}
#cena-vm-mesa /* Trilho do maestro em coluna,
#cena-vm-mesa no alto do quadro. */
        #vm-rail {
  position: absolute;
  left: 108px;
  top: 170px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  align-items: flex-start;
  padding: 22px 26px;
  background: rgba(13, 17, 23, 0.92);
  border: 2px solid var(--border);
  border-radius: 18px;
  font-family: var(--mono);
  font-weight: 700;
  font-size: 34px;
  opacity: 0;
}
#cena-vm-mesa #vm-rail .tag {
  color: var(--muted);
  font-size: 24px;
  letter-spacing: 0.14em;
  margin-bottom: 4px;
}
#cena-vm-mesa #vm-rail .chip {
  padding: 10px 24px;
  border-radius: 9999px;
  border: 2px solid var(--border);
  color: var(--muted);
  white-space: nowrap;
}
#cena-vm-mesa #vm-cost {
  position: absolute;
  left: 108px;
  right: 108px;
  top: 880px;
  padding: 30px 40px 36px;
  background: rgba(13, 17, 23, 0.94);
  border: 2px solid var(--border);
  border-radius: 18px;
  box-shadow: 0 40px 120px rgba(0, 0, 0, 0.6);
  opacity: 0;
}
#cena-vm-mesa #vm-cost .lbl {
  font-family: var(--mono);
  font-weight: 700;
  font-size: 28px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
}
#cena-vm-mesa #vm-num {
  display: inline-block;
  margin-top: 10px;
  font-family: var(--mono);
  font-weight: 700;
  font-size: 150px;
  line-height: 1;
  color: var(--text);
  font-variant-numeric: tabular-nums;
  transform-origin: 0 80%;
}
#cena-vm-mesa #vm-num .cur {
  font-size: 64px;
  color: var(--muted);
  margin-right: 18px;
}
#cena-vm-mesa #vm-bar {
  position: relative;
  margin-top: 30px;
  height: 24px;
  background: var(--surface);
  border-radius: 9999px;
  overflow: hidden;
}
#cena-vm-mesa #vm-fill {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: var(--accent);
  transform-origin: 0 50%;
}
#cena-vm-mesa #vm-cap-row {
  display: flex;
  justify-content: space-between;
  margin-top: 16px;
  font-family: var(--mono);
  font-weight: 700;
  font-size: 28px;
  color: var(--muted);
}
#cena-vm-mesa #vm-cap-row b {
  color: var(--text);
}
#cena-vm-mesa .vm-slam {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  pointer-events: none;
}
#cena-vm-mesa .vm-slam b {
  display: block;
  font-family: var(--mono);
  font-weight: 700;
  font-size: 168px;
  letter-spacing: -0.03em;
  color: var(--text);
  text-shadow: 0 0 60px rgba(13, 17, 23, 0.9), 0 0 2px rgba(13, 17, 23, 1);
  opacity: 0;
}
#cena-vm-mesa #vm-flash {
  position: absolute;
  inset: 0;
  background: #e5e7eb;
  opacity: 0;
}
</style>
