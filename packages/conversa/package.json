  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fakl/i18n": "workspace:*",
    "@fakl/protocol": "workspace:*"
  }
}
