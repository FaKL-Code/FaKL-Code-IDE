  "dependencies": {
    "@fakl/agents": "workspace:*",
    "@fakl/conversa": "workspace:*",
    "@fakl/i18n": "workspace:*",
    "@fakl/integrations": "workspace:*",
    "@fakl/protocol": "workspace:*",
    "@fakl/remote": "workspace:*",
    "yaml": "^2.9.1"
  }
