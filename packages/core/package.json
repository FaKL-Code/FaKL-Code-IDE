{
  "name": "@fakl/core",
  "version": "0.0.0",
  "private": true,
  "description": "FaKL Core: processo local que atende extensões, CLI e controle remoto pela API JSON-RPC (SDD seção 6).",
  "license": "AGPL-3.0-only",
  "type": "module",
