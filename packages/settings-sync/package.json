{
  "name": "@fakl/settings-sync",
  "version": "0.0.0",
  "private": true,
  "description": "Importação de configurações do VS Code e sincronização entre máquinas por um repositório git privado (RF-004, RF-005).",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
