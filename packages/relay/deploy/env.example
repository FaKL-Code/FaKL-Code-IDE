# Copie para .env no VPS.
# Domínio apontado para o IP do VPS (registro A), por exemplo relay.exemplo.com
FAKL_RELAY_DOMAIN=relay.exemplo.com
# Segredo longo e aleatório; o mesmo vai em "Configurar relay" na IDE.
# Gere com: openssl rand -base64 32
FAKL_RELAY_KEY=
# Imagem do relay. Padrão: a mais nova do projeto. Fixe uma versão (a mesma da
# IDE, ex. ghcr.io/fakl-code/fakl-relay:0.1.0) ou use a do seu fork.
# FAKL_RELAY_IMAGE=ghcr.io/fakl-code/fakl-relay:latest
# Contato para os serviços de push (Apple, Google, Mozilla).
VAPID_SUBJECT=mailto:voce@exemplo.com

# Só com docker-compose.traefik.yml (VPS que já roda o Traefik). Veja os valores
# com `docker network ls` e na configuração do Traefik (entrypoints e
# certificatesResolvers).
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# Opcional: vários nomes para o mesmo relay (regra do Traefik v2 e v3).
# TRAEFIK_RULE=Host(`relay.exemplo.com`) || Host(`ide.exemplo.com`)
