+interface IFaklLocalization {
+	languageId: string;
+	languageName?: string;
+	localizedLanguageName?: string;
+	translations: { id: string; path: string }[];
+}
+
+interface IFaklLanguagePack {
+	hash?: string;
+	label?: string;
+	extensions?: { extensionIdentifier: { id: string }; version: string }[];
+	translations?: Record<string, string>;
+}
+
+/**
+ * FaKL-Code: sem `--locale` nem `locale` no argv.json, a IDE segue o idioma do sistema quando
+ * traz embutido um pacote de idioma para ele (o pt-BR atende qualquer português); nos outros
+ * casos fica no inglês, como o VS Code. Sozinho o VS Code abriria em inglês: no Windows e no
+ * Linux ele passa `--lang en` ao Electron, e o pacote embutido só entra no languagepacks.json
+ * depois que o processo compartilhado sobe, ou seja, a partir da segunda abertura.
+ */
+function getFaklSystemLocale(osLocale: string): string | undefined {
+	try {
+		const extensionsPath = path.join(import.meta.dirname, '..', 'extensions');
+		const language = osLocale.split('-')[0];
+		for (const folder of fs.readdirSync(extensionsPath)) {
+			if (!folder.startsWith('vscode-language-pack-')) {
+				continue;
+			}
+			const extensionPath = path.join(extensionsPath, folder);
+			const manifest = JSON.parse(fs.readFileSync(path.join(extensionPath, 'package.json'), 'utf8'));
+			const localizations: IFaklLocalization[] = manifest.contributes?.localizations ?? [];
+			const localization = localizations.find(l => l.languageId === osLocale) ?? localizations.find(l => l.languageId.split('-')[0] === language);
+			if (localization) {
+				registerFaklLanguagePack(extensionPath, manifest, localization);
+				return localization.languageId;
+			}
+		}
+	} catch (error) {
+		console.error('FaKL-Code: could not resolve the system language', error);
+	}
+
+	return undefined;
+}
+
+/**
+ * Grava o pacote embutido no languagepacks.json no mesmo formato e com o mesmo hash do
+ * LanguagePacksCache (languagePacks.ts), que reescreve o arquivo a cada abertura.
+ */
+function registerFaklLanguagePack(extensionPath: string, manifest: { publisher: string; name: string; version: string }, localization: IFaklLocalization): void {
+	const languagePacksPath = path.join(userDataPath, 'languagepacks.json');
+	let languagePacks: Record<string, IFaklLanguagePack> = {};
+	try {
+		languagePacks = JSON.parse(fs.readFileSync(languagePacksPath, 'utf8'));
+	} catch {
+		// Primeira abertura: o arquivo ainda não existe.
+	}
+
+	const current = languagePacks[localization.languageId]?.translations?.['vscode'];
+	if (current && fs.existsSync(current)) {
+		return;
+	}
+
+	const id = `${manifest.publisher}.${manifest.name}`.toLowerCase();
+	const translations: Record<string, string> = {};
+	for (const translation of localization.translations) {
+		translations[translation.id] = path.join(extensionPath, translation.path);
+	}
+	languagePacks[localization.languageId] = {
+		hash: createHash('md5').update(id).update(manifest.version).digest('hex'),
+		label: localization.localizedLanguageName ?? localization.languageName,
+		extensions: [{ extensionIdentifier: { id }, version: manifest.version }],
+		translations
+	};
+	fs.mkdirSync(userDataPath, { recursive: true });
+	fs.writeFileSync(languagePacksPath, JSON.stringify(languagePacks));
+}
