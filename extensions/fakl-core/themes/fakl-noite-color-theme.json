  "semanticTokenColors": {
    "parameter": "#fcd9a8",
    "property": "#c4b5fd",
    "enumMember": "#fb923c",
    "*.defaultLibrary": {
      "foreground": "#93c5fd"
    }
  },
  "tokenColors": [
    {
      "name": "Comentários",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#5b6b80",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.template", "punctuation.definition.string"],
      "settings": {
        "foreground": "#86efac"
      }
    },
    {
      "name": "Escape e regex",
      "scope": ["constant.character.escape", "string.regexp"],
      "settings": {
        "foreground": "#5eead4"
      }
    },
    {
      "name": "Números e constantes",
      "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant"],
      "settings": {
        "foreground": "#fb923c"
      }
    },
    {
      "name": "Palavras-chave",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#7aa2ff"
      }
    },
    {
      "name": "Operadores",
      "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator"],
      "settings": {
        "foreground": "#9fb0c3"
      }
    },
    {
      "name": "Funções",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#22d3ee"
      }
    },
    {
      "name": "Tipos e classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#fbbf24"
      }
    },
    {
      "name": "Variáveis",
      "scope": ["variable", "meta.definition.variable.name", "support.variable"],
      "settings": {
        "foreground": "#e6edf3"
      }
    },
    {
      "name": "Parâmetros",
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#fcd9a8"
      }
    },
    {
      "name": "Propriedades",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#c4b5fd"
      }
    },
    {
      "name": "this e self",
      "scope": ["variable.language"],
      "settings": {
        "foreground": "#f472b6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#7aa2ff"
      }
    },
    {
      "name": "Atributos",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#c4b5fd"
      }
    },
    {
      "name": "Decorators",
      "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator"],
      "settings": {
        "foreground": "#f472b6"
      }
    },
    {
      "name": "Markdown: títulos",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#22d3ee",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown: ênfase",
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown: itálico",
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown: código",
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": {
        "foreground": "#a5f3fc"
      }
    },
    {
      "name": "Markdown: links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "#7dd3fc"
      }
    },
    {
      "name": "Diff: inserido",
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#4ade80"
      }
    },
    {
      "name": "Diff: removido",
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#f87171"
      }
    },
    {
      "name": "Inválido",
      "scope": ["invalid"],
      "settings": {
        "foreground": "#f87171"
      }
    }
  ]
}
